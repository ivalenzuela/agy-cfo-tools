{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start AGY CFO Tools Watcher",
      "type": "shell",
      "command": "python",
      "args": [
        "~/.gemini/config/plugins/agy-cfo-tools/watcher/auto_agents_watcher.py",
        "--workspace",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
